# ============================================
# AI表格管家 - 环境变量示例
# 复制本文件为 .env.local 并按需填写。
# 注意：文件上传等领域不要在此放任何敏感信息之外的其它值。
# ============================================

# DeepSeek 大模型 API（必填，用于需求理解/结果审查）
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Excel 处理引擎选择：node（默认）| python
# 当前阶段为预留，node 引擎尚未实现具体读写逻辑。
EXCEL_ENGINE=node

# 上传文件大小上限（字节），默认 10MB
MAX_UPLOAD_SIZE_BYTES=10485760

# 已上传文件的临时存储目录（本地 local 模式用，仅当不使用对象存储时）
UPLOAD_DIR=/tmp/aitable_uploads

# ---------- V0.4 文件存储层 ----------
# 存储驱动：
#   - 本地开发：STORAGE_DRIVER=local   （文件落本地磁盘 ./.uploads，无需 token）
#   - 生产 Vercel：STORAGE_DRIVER=blob（文件存 Vercel Blob，需配置 BLOB_READ_WRITE_TOKEN）
# 未配置时：Vercel 生产环境自动用 blob，本地自动用 local。
STORAGE_DRIVER=local

# Vercel Blob 读写 Token（仅 STORAGE_DRIVER=blob 时需要）
# 获取：vercel.com -> 项目 -> Storage -> 新建 Blob Store -> 复制 BLOB_READ_WRITE_TOKEN
# 在 Vercel 的设置里把这个值填到 Environment Variables（Production + Preview）。
BLOB_READ_WRITE_TOKEN=
